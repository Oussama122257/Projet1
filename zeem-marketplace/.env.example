# ─── Database (PostgreSQL — Supabase / Neon / local) ────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zeem?schema=public"

# ─── Auth.js / NextAuth v5 ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Redis (Upstash) — wilaya cache + rate limiting ─────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── OpenAI — AI search, descriptions, chatbot, price suggestions ───────────
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# ─── Meta Pixel + Conversions API (CAPI) ────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
# Optional: test event code from Meta Events Manager
META_TEST_EVENT_CODE=""

# ─── Delivery couriers (placeholders — fill with production credentials) ────
YALIDINE_API_ID=""
YALIDINE_API_TOKEN=""
ZR_EXPRESS_TOKEN=""
ZR_EXPRESS_KEY=""
ALGERIE_POSTE_API_KEY=""

# ─── File storage (Uploadthing or S3) ───────────────────────────────────────
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
