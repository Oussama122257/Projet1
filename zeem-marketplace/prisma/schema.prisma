// Zeem Marketplace — Prisma schema
// Multi-vendor fashion marketplace for Algeria: 58 Wilayas, COD-first,
// multi-courier logistics (Yalidine / ZR Express / Algérie Poste).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// GEOGRAPHY — Algeria's administrative divisions.
// Every Store lives in exactly one Wilaya; shipping fees are computed from the
// seller's Wilaya to the buyer's Wilaya/Commune at checkout.
// ─────────────────────────────────────────────────────────────────────────────

model Wilaya {
  id         String     @id @default(cuid())
  name       String     @unique
  code       Int        @unique // 01 (Adrar) … 58 (El Meniaa)
  // Shipping zone (1 = north/center, 4 = deep south). Used as the fallback
  // fee table when a courier has no explicit Delivery row for this wilaya.
  zone       Int        @default(1)
  communes   Commune[]
  stores     Store[]
  deliveries Delivery[]
  addresses  Address[]
}

model Commune {
  id        String    @id @default(cuid())
  name      String
  wilayaId  String
  wilaya    Wilaya    @relation(fields: [wilayaId], references: [id])
  addresses Address[]

  @@unique([wilayaId, name])
}

// Courier coverage + pricing per wilaya. Admin can toggle `isActive` per
// courier per wilaya from the Delivery Management screen.
model Delivery {
  id       String          @id @default(cuid())
  company  DeliveryCompany
  wilayaId String
  wilaya   Wilaya          @relation(fields: [wilayaId], references: [id])
  homeFee  Float // Livraison à domicile (DZD)
  deskFee  Float // Point de retrait / stop-desk (DZD)
  isActive Boolean         @default(true)

  @@unique([company, wilayaId])
}

// ─────────────────────────────────────────────────────────────────────────────
// USERS & AUTH (Auth.js v5)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id         String    @id @default(cuid())
  name       String?
  email      String?   @unique
  // Phone is the primary identifier in Algeria (+213XXXXXXXXX).
  // Nullable because Google OAuth users arrive without one; buyers must add
  // it before checkout, sellers/agents at registration.
  phone      String?   @unique
  password   String? // bcrypt hash — null for OAuth-only accounts
  role       Role      @default(BUYER)
  isVerified Boolean   @default(false)
  image      String?
  store      Store?
  orders     Order[]   @relation("BuyerOrders")
  addresses  Address[]
  accounts   Account[]
  sessions   Session[]
  createdAt  DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Delivery addresses. Guest fast-checkout creates an Address with userId=null.
model Address {
  id            String  @id @default(cuid())
  userId        String?
  user          User?   @relation(fields: [userId], references: [id])
  fullName      String
  phone         String // +213…
  wilayaId      String
  wilaya        Wilaya  @relation(fields: [wilayaId], references: [id])
  communeId     String
  commune       Commune @relation(fields: [communeId], references: [id])
  streetAddress String // Adresse complète (rue, bâtiment, repères)
  orders        Order[]
}

// ─────────────────────────────────────────────────────────────────────────────
// STORES & PRODUCTS
// ─────────────────────────────────────────────────────────────────────────────

model Store {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id])
  name           String
  slug           String        @unique
  logo           String?
  description    String?
  wilayaId       String
  wilaya         Wilaya        @relation(fields: [wilayaId], references: [id])
  commune        String?
  // Stores start inactive; admin approves after checking the business licence.
  isActive       Boolean       @default(false)
  licenceUrl     String? // Registre de commerce (uploaded document)
  commissionRate Float         @default(10.0) // % Zeem takes on each sale
  balance        Float         @default(0.0) // COD earnings awaiting payout
  products       Product[]
  shipments      Shipment[]
  transactions   Transaction[]
  sizeCharts     SizeChart[]
}

// Seller-provided sizing chart used by the AI Size Recommender.
// entries: [{ size: "M", minWeightKg: 60, maxWeightKg: 75, minHeightCm: 165, maxHeightCm: 178 }]
model SizeChart {
  id       String    @id @default(cuid())
  storeId  String
  store    Store     @relation(fields: [storeId], references: [id])
  name     String // e.g. "Kaftans femme", "Chemises homme slim"
  entries  Json
  products Product[]
}

model Product {
  id              String        @id @default(cuid())
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id])
  name            String
  slug            String        @unique
  description     String?
  price           Float // DZD
  comparePrice    Float? // Ancien prix (promo barrée)
  stock           Int
  sizes           String[] // ['S','M','L','XL']
  colors          String[]
  images          String[]
  category        String // 'Robes', 'Kaftans', 'Hijabs', 'Accessoires'…
  weight          Float? // kg — used for courier fee calculation
  status          ProductStatus @default(DRAFT)
  aiGeneratedDesc Boolean       @default(false)
  views           Int           @default(0)
  soldCount       Int           @default(0)
  sizeChartId     String?
  sizeChart       SizeChart?    @relation(fields: [sizeChartId], references: [id])
  orderItems      OrderItem[]
  createdAt       DateTime      @default(now())

  @@index([category])
  @@index([storeId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// ORDERS — COD only.
// FAST  = "Acheter Maintenant": 5 fields, no account, single product.
// CART  = multi-vendor cart: 1 parent Order, N Shipments (one per store),
//         each shipment carries its own delivery fee and COD amount.
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id              String        @id @default(cuid())
  reference       String        @unique // Human-friendly, shown to buyer (ZM-XXXXXX)
  buyerId         String? // null for guest fast-checkout
  buyer           User?         @relation("BuyerOrders", fields: [buyerId], references: [id])
  guestName       String?
  guestPhone      String?
  totalAmount     Float // items + all shipping fees
  platformFee     Float         @default(0.0) // total Zeem commission
  status          OrderStatus   @default(PENDING)
  checkoutType    CheckoutType
  // Attribution for Meta Ads ROAS reporting
  utmSource       String?
  utmCampaign     String?
  // Meta Pixel event id — same id is sent browser-side (on order) and
  // server-side (on delivery) so Meta deduplicates the Purchase event.
  pixelEventId    String?
  shippingAddress Address?      @relation(fields: [addressId], references: [id])
  addressId       String?
  shipments       Shipment[]
  items           OrderItem[]
  transactions    Transaction[]
  createdAt       DateTime      @default(now())

  @@index([status, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  sellerId  String // Store id, denormalized for fast per-seller queries
  quantity  Int
  price     Float // price snapshot at purchase time
  size      String?
  color     String?
}

model Shipment {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id])
  sellerId        String
  seller          Store           @relation(fields: [sellerId], references: [id])
  deliveryCompany DeliveryCompany
  trackingNumber  String?
  waybillUrl      String?
  shippingFee     Float
  codAmount       Float // total cash the courier must collect for this shipment
  actualCollected Float? // what the agent actually received
  status          ShipmentStatus  @default(PENDING_PICKUP)
  agentId         String? // User (role AGENT) handling delivery
  agentNote       String?
  deliveredAt     DateTime?
  signatureUrl    String? // photo proof of delivery

  @@index([agentId, status])
  @@index([sellerId, status])
}

// Seller money movements. On COD collection we create a PAYOUT for
// (codAmount - commission - shippingFee) and credit Store.balance.
model Transaction {
  id       String      @id @default(cuid())
  sellerId String
  seller   Store       @relation(fields: [sellerId], references: [id])
  orderId  String?
  order    Order?      @relation(fields: [orderId], references: [id])
  amount   Float
  type     TransType
  status   TransStatus @default(PENDING)
  dueDate  DateTime?
  paidAt   DateTime?
  createdAt DateTime   @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// MARKETING — coupons, flash sales, server-side pixel audit log
// ─────────────────────────────────────────────────────────────────────────────

model Coupon {
  id        String     @id @default(cuid())
  code      String     @unique
  type      CouponType
  value     Float // percent (0–100) or fixed DZD
  minAmount Float?
  maxUses   Int        @default(100)
  usedCount Int        @default(0)
  isActive  Boolean    @default(true)
  expiresAt DateTime?
  createdAt DateTime   @default(now())
}

model FlashSale {
  id              String   @id @default(cuid())
  title           String
  discountPercent Float
  productIds      String[]
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean  @default(true)
}

// Every server-side Meta CAPI call is logged here so admins can audit what
// left the platform (Pixel Manager screen).
model PixelEventLog {
  id        String   @id @default(cuid())
  eventName String // 'Purchase', 'InitiateCheckout'…
  eventId   String // dedup key shared with the browser pixel
  orderId   String?
  payload   Json
  status    String // 'SENT' | 'FAILED' | 'SKIPPED'
  error     String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  BUYER
  SELLER
  ADMIN
  AGENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum CheckoutType {
  FAST
  CART
}

enum ShipmentStatus {
  PENDING_PICKUP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TransType {
  COMMISSION
  PAYOUT
  REFUND
}

enum TransStatus {
  PENDING
  PAID
  FAILED
}

enum DeliveryCompany {
  YALIDINE
  ZR_EXPRESS
  POSTE
}

enum CouponType {
  PERCENT
  FIXED
}
