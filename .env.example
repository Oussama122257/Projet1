# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ColiShip DZ

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/coliship_dz

# Shopify App
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SCOPES=read_orders,write_orders,read_products,read_customers,write_shipping
SHOPIFY_HOST_NAME=your-app.vercel.app

# Algerian Carrier APIs
YALIDINE_API_KEY=your_yalidine_api_key
YALIDINE_API_ID=your_yalidine_api_id
YALIDINE_BASE_URL=https://api.yalidine.app/v1

ZR_EXPRESS_API_KEY=your_zr_express_api_key
ZR_EXPRESS_BASE_URL=https://api.zrexpress.com/api

MAYSTRO_API_KEY=your_maystro_api_key
MAYSTRO_BASE_URL=https://api.maystro-delivery.com/api/v1

PROCOLIS_API_KEY=your_procolis_api_key
PROCOLIS_BASE_URL=https://procolis.com/api_v1

DHD_API_KEY=your_dhd_api_key
DHD_BASE_URL=https://api.dhd.dz/api/v1

NOEST_API_KEY=your_noest_api_key
NOEST_BASE_URL=https://api.noest.dz/api/v1

ECOTRACK_API_KEY=your_ecotrack_api_key
ECOTRACK_BASE_URL=https://api.ecotrack.dz/api/v1

# SMS Provider
SMS_PROVIDER=twilio
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret
SMS_SENDER_ID=ColiShipDZ

# JWT
JWT_SECRET=your_jwt_secret_key

# Webhook Secret
WEBHOOK_SECRET=your_webhook_secret
