# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://contentloop:contentloop@localhost:5432/contentloop
REDIS_URL=redis://localhost:6379
AUTH_SECRET=change-me-32-bytes-minimum-random-string
# Any random string >= 32 chars (AES-256 key is derived via SHA-256).
# ./setup.sh generates both secrets automatically.
ENCRYPTION_KEY=change-me-32-bytes-minimum-random-string
APP_URL=http://localhost:3000

# ── Apify (server-side only) ─────────────────────────────────────────────────
APIFY_API_TOKEN=
# Configurable Actor. Consult the Actor's documented input schema and set the
# input template accordingly (JSON with {{url}} {{username}} {{limit}} placeholders).
APIFY_ACTOR_ID=
APIFY_INPUT_TEMPLATE=
APIFY_WEBHOOK_SECRET=

# ── AI providers ─────────────────────────────────────────────────────────────
AI_PROVIDER=anthropic            # anthropic | openai | gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Centralized model routing — never hardcode model names in code
AI_MODEL_LIGHT=claude-haiku-4-5-20251001
AI_MODEL_STANDARD=claude-sonnet-5
AI_MODEL_DEEP=claude-opus-5
AI_EMBEDDING_MODEL=text-embedding-3-small

# ── Storage (Cloudflare R2, S3-compatible) ───────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=contentloop-media
R2_PUBLIC_BASE_URL=
