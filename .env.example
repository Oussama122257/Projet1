# Copy to .env and fill in. NEVER commit the real .env.

ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string

# Database / queue (defaults match docker-compose)
DATABASE_URL=postgresql+psycopg2://reelay:reelay@postgres:5432/reelay
REDIS_URL=redis://redis:6379/0

# Pipeline
SCAN_INTERVAL_MINUTES=60
SCAN_JITTER_SECONDS=1800
MAX_DOWNLOADS_PER_SCAN=20
DEFAULT_DAILY_CAP=4

# Google Drive (service-account JSON mounted at /secrets/gdrive.json)
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/gdrive.json
GDRIVE_ROOT_FOLDER_ID=

# Metricool (Advanced plan required for API access)
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BASE_URL=https://app.metricool.com/api

# Telegram (bot token from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public base URL that serves staged media to Metricool (e.g. Cloudflare R2 / CDN)
MEDIA_PUBLIC_BASE_URL=

# OpenClaw chat-driven control layer (optional profile)
ANTHROPIC_API_KEY=
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-string
