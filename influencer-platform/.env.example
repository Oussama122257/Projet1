# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://influencer:influencer@localhost:5432/influencer_platform?schema=public"

# ---------------------------------------------------------------------------
# Auth (NextAuth)
# ---------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32
NEXTAUTH_SECRET=""

# Google sign-in for brands/admins (optional in dev — email+password works without it)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Token encryption — social OAuth tokens are AES-256-GCM encrypted at rest.
# Must be 32 bytes hex-encoded: openssl rand -hex 32
# Rotating this invalidates every stored social token (users must reconnect).
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Social platforms
# ---------------------------------------------------------------------------
# TikTok — Login Kit + Display API (https://developers.tiktok.com)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/social/tiktok/callback"

# Instagram Graph API (phase 2)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/social/instagram/callback"

# YouTube Data API v3 (phase 2)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/social/youtube/callback"

# ---------------------------------------------------------------------------
# Stripe — Connect is required: influencers are third parties receiving
# transfers, so they each need their own connected account.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_CONNECT_CLIENT_ID=""
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Jobs
# ---------------------------------------------------------------------------
# Hourly metric sync. Set to "false" to disable the in-process scheduler.
CRON_ENABLED="true"
SYNC_CRON_SCHEDULE="0 * * * *"
# Shared secret for POST /api/cron/sync (Vercel Cron / external scheduler).
CRON_SECRET=""

# When true, tracking services return deterministic simulated metrics instead of
# calling live platform APIs. Keep true in dev unless you have real app credentials.
USE_MOCK_METRICS="true"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
