#!/usr/bin/env python3
"""reelayctl — the scoped command surface for the Reelay pipeline.

OpenClaw's assistant runs THIS (via its `exec` tool), never raw shell. Every
command is a thin, safe wrapper over the Reelay API. Output is plain text so the
assistant can relay it to Telegram cleanly.

Config: REELAY_API_BASE (default http://api:8000).

Usage:
  reelayctl status
  reelayctl sources
  reelayctl queue
  reelayctl approve <video_id> [--caption "..."]
  reelayctl skip <video_id>
  reelayctl pause-source <source_id>
  reelayctl resume-source <source_id>
  reelayctl add-source <username> [--proxy GROUP] [--to DEST_ID ...]
  reelayctl add-destination <username> [--brand BRAND_ID] [--cap N]
  reelayctl retry-failed
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.request

BASE = os.getenv("REELAY_API_BASE", "http://api:8000").rstrip("/")


def _req(method: str, path: str, body: dict | None = None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(
        f"{BASE}{path}", data=data, method=method,
        headers={"Content-Type": "application/json", "Accept": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = resp.read().decode()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        detail = e.read().decode()
        try:
            detail = json.loads(detail).get("detail", detail)
        except Exception:
            pass
        sys.exit(f"error {e.code}: {detail}")
    except urllib.error.URLError as e:
        sys.exit(f"cannot reach Reelay API at {BASE}: {e.reason}")


def cmd_status(_):
    s = _req("GET", "/api/ops/status")
    src, vid, post = s["sources"], s["videos"], s["posts"]
    print(f"Sources: {src['healthy']}/{src['total']} healthy, {src['active']} active")
    if src["cooling_down"]:
        print(f"  cooling down: {', '.join('@' + u for u in src['cooling_down'])}")
    print(f"Awaiting approval: {vid['awaiting_approval']}   scraped 24h: {vid['scraped_24h']}   failed: {vid['failed']}")
    print(f"Scheduled: {post['scheduled']}   published 7d: {post['published_7d']}")


def cmd_sources(_):
    rows = _req("GET", "/api/sources")
    if not rows:
        print("No source accounts yet. Add one with: reelayctl add-source <username>")
        return
    for r in rows:
        flag = "" if r["is_active"] else " (paused)"
        print(f"#{r['id']:>3}  @{r['username']:<24} {r['status']:<13} {r['proxy_group']}{flag}")


def cmd_queue(_):
    rows = _req("GET", "/api/ops/queue")
    if not rows:
        print("Approval queue is empty. 🎉")
        return
    for r in rows:
        print(f"#{r['id']:>3}  {r['shortcode']:<14} {r['caption']}")


def cmd_approve(a):
    body = {"approve": True}
    if a.caption:
        body["caption"] = a.caption
    _req("POST", f"/api/videos/{a.video_id}/decision", body)
    print(f"✅ Approved video #{a.video_id} — scheduling to its destinations.")


def cmd_skip(a):
    _req("POST", f"/api/videos/{a.video_id}/decision", {"approve": False})
    print(f"⏭ Skipped video #{a.video_id}.")


def cmd_pause(a):
    r = _req("POST", f"/api/sources/{a.source_id}/pause")
    print(f"⏸ Paused @{r['username']}.")


def cmd_resume(a):
    r = _req("POST", f"/api/sources/{a.source_id}/resume")
    print(f"▶ Resumed @{r['username']}.")


def cmd_add_source(a):
    body = {"username": a.username, "proxy_group": a.proxy, "destination_ids": a.to or []}
    r = _req("POST", "/api/sources", body)
    print(f"➕ Added source @{r['username']} (#{r['id']}), proxy {r['proxy_group']}.")


def cmd_add_destination(a):
    body = {"username": a.username, "metricool_brand_id": a.brand, "daily_cap": a.cap}
    r = _req("POST", "/api/destinations", body)
    print(f"➕ Added destination @{r['username']} (#{r['id']}), cap {r['daily_cap']}/day.")


def cmd_retry_failed(_):
    r = _req("POST", "/api/ops/retry-failed")
    print(f"🔁 Retried {r['retried']} failed video(s).")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="reelayctl", description="Control the Reelay pipeline.")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status").set_defaults(fn=cmd_status)
    sub.add_parser("sources").set_defaults(fn=cmd_sources)
    sub.add_parser("queue").set_defaults(fn=cmd_queue)
    sub.add_parser("retry-failed").set_defaults(fn=cmd_retry_failed)

    ap = sub.add_parser("approve"); ap.add_argument("video_id", type=int)
    ap.add_argument("--caption"); ap.set_defaults(fn=cmd_approve)

    sk = sub.add_parser("skip"); sk.add_argument("video_id", type=int); sk.set_defaults(fn=cmd_skip)

    ps = sub.add_parser("pause-source"); ps.add_argument("source_id", type=int); ps.set_defaults(fn=cmd_pause)
    rs = sub.add_parser("resume-source"); rs.add_argument("source_id", type=int); rs.set_defaults(fn=cmd_resume)

    asrc = sub.add_parser("add-source"); asrc.add_argument("username")
    asrc.add_argument("--proxy", default="default"); asrc.add_argument("--to", type=int, nargs="*")
    asrc.set_defaults(fn=cmd_add_source)

    ad = sub.add_parser("add-destination"); ad.add_argument("username")
    ad.add_argument("--brand"); ad.add_argument("--cap", type=int, default=4)
    ad.set_defaults(fn=cmd_add_destination)
    return p


def main():
    args = build_parser().parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
